{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/lateral-html/Demo08/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/lateral-html/Demo08/index.html"
    },
    {
      "source": "/style.css",
      "destination": "/lateral-html/Demo08/style.css"
    },
    {
      "source": "/css/:path*",
      "destination": "/lateral-html/Demo08/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/lateral-html/Demo08/js/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/lateral-html/Demo08/images/:path*"
    },
    {
      "source": "/downloads/:path*",
      "destination": "/lateral-html/Demo08/downloads/:path*"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"qm-salon-landing-page-template.zip\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/lateral-html/Demo08/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"qm-salon-landing-page-template.zip\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
